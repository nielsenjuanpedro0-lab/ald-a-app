{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlDia",
  "version": "0.1.3",
  "identifier": "com.argbroker.aldia",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AlDía",
        "width": 1360,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../backend/dist_nuitka/server.dist": "backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NUI0RkEwMTE4RTdEMDQKUldRRWZZNFJvRTliU0NNVGhKOFpFdWpJeU53REk1eUR1aFIwRkgyK1dZSzZ4NTdwTEtNVnQ0cFUK",
      "endpoints": [
        "https://github.com/nielsenjuanpedro0-lab/ald-a-app/releases/latest/download/latest.json"
      ]
    }
  }
}
